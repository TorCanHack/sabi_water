# Copy to .env and fill in locally. Never commit real credentials.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Set to 1 behind Render or one trusted reverse proxy; 0 for direct access.
TRUST_PROXY=0
# Production requires your exact HTTPS origin(s), comma separated, no trailing /.
FRONTEND_URL=http://localhost:5174

# Supply your PostgreSQL connection URL, or use the PG* settings below.
DATABASE_URL=
# DATABASE_SSL=true
# TLS settings in DATABASE_URL must not be combined with DATABASE_SSL.
# For a private CA, set DATABASE_SSL=true and supply its PEM (literal \n allowed).
# DATABASE_CA_CERT=
DATABASE_POOL_MAX=10
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=postgres

# Server-only: never put this secret in frontend code or a VITE_ variable.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5174/?payment=return

# Optional Business Padi owner UUID for connected fulfilment.
BUSINESS_PADI_OWNER_ID=
